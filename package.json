{
	"type": "module",
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@octokit/plugin-throttling": "^11.0.3",
		"axios": "^1.20.0",
		"commitlint-config-gitmoji": "^2.3.1",
		"yaml": "^2.9.0"
	},
	"scripts": {
		"watch": "ncc build src/index.js --watch --license licenses.txt",
		"lint:commit": "commitlint --last --verbose",
		"test": "node --test --test-reporter=spec test/unit/artifact-check.test.mjs",
  		"test:unit": "node --test --test-reporter=spec test/unit/artifact-check.test.mjs",
  		"test:integration": "node --test --test-reporter=spec test/integration/bundle.test.mjs",
  		"test:coverage": "mkdir -p reports coverage && node --test --experimental-test-coverage --test-coverage-include=scripts/** --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/unit-junit.xml --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/unit/artifact-check.test.mjs"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@vercel/ncc": "^0.44.1"
	}
}
